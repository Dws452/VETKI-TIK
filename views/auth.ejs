<% layout('./layout/page.ejs') %>
<div class="auth-wrap"><div class="auth-visual"><img src="/images/tik-mark.svg" alt="TIK"><span class="section-kicker">SECURE ANALYST ACCESS</span><h2>Информация —<br><em>твоя защита.</em></h2><p>Войди в рабочее пространство TIK, чтобы сохранять результаты анализа и управлять записями.</p><div class="auth-decoration">TIK / 0x01</div></div><div class="auth-form"><span class="section-kicker"><%= mode === 'register' ? 'CREATE ACCOUNT' : 'WELCOME BACK' %></span><h2><%= mode === 'register' ? 'Создать аккаунт' : 'С возвращением' %></h2><p><%= mode === 'register' ? 'Заполни данные аналитика для регистрации.' : 'Введи логин и пароль, чтобы продолжить.' %></p><%- include('./partials/auth-message') %><form action="/auth" method="post"><input type="hidden" name="mode" value="<%= mode %>"><label>Логин<input name="username" required minlength="3" placeholder="Например, analyst01"></label><% if (mode === 'register') { %><label>Email<input name="email" type="email" required placeholder="name@example.com"></label><% } %><label>Пароль<input name="password" type="password" required minlength="8" placeholder="Минимум 8 символов"></label><button class="btn-primary-custom w-100" type="submit"><%= mode === 'register' ? 'Зарегистрироваться →' : 'Войти в систему →' %></button></form><div class="auth-switch"><%= mode === 'register' ? 'Уже есть аккаунт?' : 'Впервые в TIK?' %> <a href="/<%= mode === 'register' ? 'login' : 'register' %>"><%= mode === 'register' ? 'Войти' : 'Создать аккаунт' %></a></div></div></div>
