<% layout('./layout/page.ejs') %>
<div class="page-intro"><div><span class="section-kicker">INDICATORS OF COMPROMISE</span><p>Технические артефакты, которые помогают обнаруживать и связывать инциденты.</p></div><% if (currentUser) { %><span class="count-pill">Доступно добавление IOC</span><% } else { %><a class="count-pill" href="/login">Войди для добавления IOC</a><% } %></div><section class="panel"><form class="filter-bar" method="get"><div class="search-box"><span>⌕</span><input name="q" value="<%= q %>" placeholder="Найти IP, домен, URL или хеш..."></div><button class="btn-filter">Найти IOC</button></form><div class="ioc-grid"><% iocs.forEach(ioc => { %><article class="ioc-card"><div class="ioc-card-top"><span class="ioc-type"><%= ioc.type %></span><span class="ioc-state"><i></i><%= ioc.status %></span></div><b><%= ioc.value %></b><button class="copy-link" type="button" data-copy="<%= ioc.value %>">Копировать</button><div class="ioc-meta"><span>Источник <strong><%= ioc.source %></strong></span><span>Связь <strong><%= ioc.threat %></strong></span></div><div class="confidence-line"><div><span>Уверенность</span><b><%= ioc.confidence %>%</b></div><div class="confidence-track"><i style="width:<%= ioc.confidence %>%"></i></div></div></article><% }) %></div><% if (currentUser) { %><form class="ioc-add-form" action="/iocs" method="post"><div><label>Значение IOC<input name="value" required placeholder="IP, домен, URL или хеш"></label></div><div><label>Тип<select name="type"><option>IPv4</option><option>Domain</option><option>URL</option><option>MD5</option><option>SHA1</option><option>SHA256</option></select></label></div><div><label>Уверенность<input name="confidence" type="number" min="0" max="100" value="80"></label></div><div><label>Источник<input name="source" placeholder="Например, SOC analyst"></label></div><button class="btn-primary-custom" type="submit">Добавить индикатор →</button></form><% } %><% if (!iocs.length) { %><div class="empty-state">Индикаторы не найдены.</div><% } %></section>
