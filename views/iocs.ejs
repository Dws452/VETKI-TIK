<% layout('./layout/page.ejs') %>
<div class="page-intro"><div><span class="section-kicker">INDICATORS OF COMPROMISE</span><p>Технические артефакты, которые помогают обнаруживать и связывать инциденты.</p></div><span class="count-pill"><%= iocs.length %> индикаторов</span></div><section class="panel"><form class="filter-bar" method="get"><div class="search-box"><span>⌕</span><input name="q" value="<%= q %>" placeholder="Найти IP, домен, URL или хеш..."></div><button class="btn-filter">Найти IOC</button></form><div class="ioc-grid"><% iocs.forEach(ioc => { %><article class="ioc-card"><div class="ioc-card-top"><span class="ioc-type"><%= ioc.type %></span><span class="ioc-state"><i></i><%= ioc.status %></span></div><b><%= ioc.value %></b><div class="ioc-meta"><span>Источник <strong><%= ioc.source %></strong></span><span>Связь <strong><%= ioc.threat %></strong></span></div><div class="confidence-line"><div><span>Уверенность</span><b><%= ioc.confidence %>%</b></div><div class="confidence-track"><i style="width:<%= ioc.confidence %>%"></i></div></div></article><% }) %></div><% if (!iocs.length) { %><div class="empty-state">Индикаторы не найдены.</div><% } %></section>
