<aside class="sidebar"><a class="brand" href="/"><img src="/images/tik-mark.svg" alt="TIK"><span>TIK<small>THREAT INTELLIGENCE</small></span></a><div class="side-label">WORKSPACE</div><% navItems.forEach(item => { %><a class="side-link <%= currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'active' : '' %>" href="<%= item.href %>"><span class="nav-icon"><%= item.icon %></span> <%= item.label %></a><% }) %><div class="side-bottom"><div class="system-card"><span class="pulse-dot"></span><span>Система активна</span><small><%= dbReady ? 'MONGODB CONNECTED' : 'DEMO MODE' %></small></div><% if (currentUser) { %><div class="user-mini"><div class="avatar"><%= currentUser.username.slice(0,1).toUpperCase() %></div><div><b><%= currentUser.username %></b><small><%= currentUser.role %></small></div><form action="/logout" method="post"><button class="icon-button" title="Выйти">↗</button></form></div><% } else { %><a class="login-link" href="/login">Войти / Регистрация <span>→</span></a><% } %></div></aside>
