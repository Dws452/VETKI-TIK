<% layout('./layout/page.ejs') %>
<div class="form-wrap"><div class="form-heading"><span class="section-kicker">NEW INTELLIGENCE RECORD</span><p>Добавь описание события, чтобы команда могла оценить риск.</p></div><% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %><form class="panel form-panel" action="/threats" method="post"><label>Название угрозы<input name="title" required maxlength="140" value="<%= threat.title || '' %>" placeholder="Например, подозрительная активность на узле"></label><div class="form-two"><label>Категория<select name="category"><% ['Phishing','Malware','Reconnaissance','Command and Control','Data breach','Other'].forEach(x => { %><option><%= x %></option><% }) %></select></label><label>Уровень риска<select name="severity"><% ['Low','Medium','High','Critical'].forEach(x => { %><option><%= x %></option><% }) %></select></label></div><label>Описание<textarea name="description" required rows="5" placeholder="Что произошло, какие системы затронуты и почему событие важно..."><%= threat.description || '' %></textarea></label><label>Теги через запятую<input name="tags" placeholder="phishing, email, credential-theft"></label><div class="form-actions"><a href="/threats" class="btn-outline-custom">Отмена</a><button class="btn-primary-custom" type="submit">Сохранить угрозу →</button></div></form></div>
