<% layout('./layout/page.ejs') %>
<div class="page-intro"><div><span class="section-kicker">THREAT DATABASE</span><p>Отслеживай инциденты, оценивай приоритет и фиксируй ход расследования.</p></div><% if (currentUser) { %><a href="/threats/new" class="btn-primary-custom">＋ Добавить угрозу</a><% } else { %><a href="/login" class="btn-primary-custom">Войти для добавления</a><% } %></div>
<section class="panel"><form class="filter-bar" method="get"><div class="search-box"><span>⌕</span><input name="q" value="<%= filters.q %>" placeholder="Поиск по названию или описанию..."></div><select name="severity"><option value="">Все уровни риска</option><% ['Critical','High','Medium','Low'].forEach(level => { %><option value="<%= level %>" <%= filters.severity === level ? 'selected' : '' %>><%= level %></option><% }) %></select><button class="btn-filter">Применить</button></form><div class="table-responsive"><table class="data-table"><thead><tr><th>УГРОЗА</th><th>КАТЕГОРИЯ</th><th>УРОВЕНЬ</th><th>СТАТУС</th><th>ИСТОЧНИК</th><th>ДАТА</th></tr></thead><tbody><% threats.forEach(threat => { %><tr><td><b><%= threat.title %></b><small class="table-sub"><%= threat.description %></small></td><td><span class="category-tag"><%= threat.category %></span></td><td><span class="severity severity-<%= threat.severity.toLowerCase() %>"><%= threat.severity %></span></td><td><%= threat.status %></td><td><%= threat.source %></td><td><%= new Date(threat.createdAt || threat.createdAt).toLocaleDateString('ru-RU') %></td></tr><% }) %></tbody></table></div><% if (!threats.length) { %><div class="empty-state">По этому запросу ничего не найдено.</div><% } %></section>
